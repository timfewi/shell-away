{
  "version": 1,
  "checks": [
    {
      "name": "format",
      "argv": ["just", "fmt-check"],
      "requires": ["just", "python3", "rg", "nixfmt", "shfmt", "prettier"],
      "timeout_seconds": 120,
      "profiles": ["fast"]
    },
    {
      "name": "shell-away",
      "argv": ["bash", "scripts/test"],
      "requires": ["bash", "zsh", "script", "shellcheck"],
      "timeout_seconds": 60,
      "profiles": ["fast"]
    },
    {
      "name": "statix",
      "argv": ["statix", "check", "."],
      "requires": ["statix"],
      "timeout_seconds": 120,
      "profiles": ["fast"]
    },
    {
      "name": "deadnix",
      "argv": ["deadnix", "--fail", "."],
      "requires": ["deadnix"],
      "timeout_seconds": 120,
      "profiles": ["fast"]
    },
    {
      "name": "flake-check",
      "argv": ["nix", "flake", "check", "--no-write-lock-file", "."],
      "requires": ["nix"],
      "timeout_seconds": 900,
      "profiles": ["full"]
    }
  ],
  "watch_ignore": [".direnv", "result", "result-*"]
}
